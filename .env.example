# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------
# Development uses SQLite (db.sqlite3) — nothing to configure.
# The PostgreSQL block below is only read by config/settings/prod.py.
# ---------------------------------------------------------------------

# prod only
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.ma
POSTGRES_DB=smartrent
POSTGRES_USER=smartrent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432